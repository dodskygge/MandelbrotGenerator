<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MandelbrotGenerator</RootNamespace>
    <AssemblyName>MandelbrotGenerator</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollector>true</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <None Update="input.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
